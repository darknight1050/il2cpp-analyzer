# Copy to .env and adjust. docker compose reads this file for the values below,
# and the app reads MONGODB_URI / ELASTICSEARCH_URI when run outside Docker.

# --- credentials ------------------------------------------------------------
MONGO_USER=analyzer
MONGO_PASSWORD=changeme
MONGO_DB=analyzer
# must match the major that wrote MONGO_DATA_PATH (check: db.version())
MONGO_VERSION=8

# --- host port bindings (all published on 127.0.0.1 only) -------------------
APP_PORT=5000
MONGO_PORT=27017
ES_PORT=9200

# --- data locations on the host ---------------------------------------------
# versions/ is the symbol cache and grows to many GB.
ES_DATA_PATH=./elasticsearch-data
MONGO_DATA_PATH=./db
VERSIONS_PATH=./versions

# --- Elasticsearch heap ------------------------------------------------------
ES_HEAP=2g

# --- used only when running the app directly on the host (npm start,
#     npm run recreateIndex, ...). Inside Docker these come from compose.
MONGODB_URI=mongodb://analyzer:changeme@127.0.0.1:27017/analyzer?ssl=false&authSource=admin
ELASTICSEARCH_URI=http://localhost:9200
